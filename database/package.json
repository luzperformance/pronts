{
  "name": "@primeiro-prontuario/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config=drizzle.migrate.config.ts",
    "test": "tsx --test test/**/*.test.ts",
    "verify:equivalence": "tsx --test test/schema-equivalence.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
